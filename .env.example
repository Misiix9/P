# =================================================================
# PORTFOLIO DESKTOP OS - API CONFIGURATION
# =================================================================
# Copy this file to .env and fill in your API keys
# Get your API keys from the respective services below

# =================================================================
# WEATHER API - OpenWeatherMap
# =================================================================
# Get your free API key from: https://openweathermap.org/api
# Sign up for free, supports 1000 calls/day
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# =================================================================
# STOCK MARKET API - Alpha Vantage
# =================================================================
# Get your free API key from: https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests per day, 5 requests per minute
VITE_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Alternative Stock API - Finnhub (more generous free tier)
# Get your free API key from: https://finnhub.io/register
# Free tier: 60 calls/minute
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# =================================================================
# NEWS API - NewsAPI.org
# =================================================================
# Get your free API key from: https://newsapi.org/register
# Free tier: 1000 requests/month
VITE_NEWS_API_KEY=your_news_api_key_here

# =================================================================
# CALENDAR API - Google Calendar
# =================================================================
# Get your API key from Google Cloud Console
# Follow guide: https://developers.google.com/calendar/api/quickstart/js
VITE_GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key_here
VITE_GOOGLE_CALENDAR_ID=your_google_calendar_id_here

# =================================================================
# MAPS API - Google Maps
# =================================================================
# Get your API key from Google Cloud Console
# Enable Maps JavaScript API and Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# =================================================================
# CRYPTOCURRENCY API - CoinGecko
# =================================================================
# CoinGecko API is free and doesn't require an API key for basic usage
# But you can get a pro key for higher rate limits: https://www.coingecko.com/en/api/pricing
VITE_COINGECKO_API_KEY=optional_coingecko_pro_key_here

# =================================================================
# MUSIC API - Spotify Web API
# =================================================================
# Get your credentials from: https://developer.spotify.com/dashboard
# Create an app and get your Client ID and Secret
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# =================================================================
# YOUTUBE API - YouTube Data API v3
# =================================================================
# Get your API key from Google Cloud Console
# Enable YouTube Data API v3
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# =================================================================
# EMAIL SERVICE - EmailJS
# =================================================================
# Get your credentials from: https://www.emailjs.com/
# Free tier: 200 emails/month
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# =================================================================
# GEOLOCATION API - IPGeolocation
# =================================================================
# Get your free API key from: https://ipgeolocation.io/
# Free tier: 1000 requests/month
VITE_IPGEOLOCATION_API_KEY=your_ipgeolocation_api_key_here

# =================================================================
# UNSPLASH API - For Gallery App
# =================================================================
# Get your API key from: https://unsplash.com/developers
# Free tier: 50 requests/hour
VITE_UNSPLASH_API_KEY=your_unsplash_api_key_here

# =================================================================
# DEVELOPMENT SETTINGS
# =================================================================
# Set to 'true' to use mock data when API keys are not available
VITE_USE_MOCK_DATA=false

# Enable/disable API rate limiting protection
VITE_ENABLE_RATE_LIMITING=true

# API request timeout in milliseconds
VITE_API_TIMEOUT=10000